#!/bin/sh
# Fast checks for staged changes. Enable with `make hooks`.
set -eu

cd "$(git rev-parse --show-toplevel)"

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

if printf '%s\n' "$staged" | grep -qE '\.go$'; then
	echo "pre-commit: golangci-lint (new issues)"
	if ! run golangci-lint run --new ./...; then
		echo "pre-commit: fix with 'make lint-fix' and 'make fmt'"
		exit 1
	fi
fi

if printf '%s\n' "$staged" | grep -qE '^frontend/.*\.(ts|js|css|json)$'; then
	if [ -d frontend/node_modules ]; then
		echo "pre-commit: frontend typecheck + Biome"
		if ! (cd frontend && run pnpm run check); then
			echo "pre-commit: fix with 'cd frontend && pnpm run lint:fix'"
			exit 1
		fi
	else
		echo "pre-commit: frontend/node_modules missing, skipping frontend checks (make setup)"
	fi
fi
