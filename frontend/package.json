    "@pierre/diffs": "^1.6.2",
    "@pierre/highlights": "^0.3.0",
    "@pierre/trees": "^1.0.0-beta.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
