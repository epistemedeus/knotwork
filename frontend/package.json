{
  "name": "knotwork-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
